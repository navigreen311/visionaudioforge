# Copy to .env only if you want to override the defaults baked into
# docker-compose.yml. The stack boots from a clean clone with no .env at all —
# `docker compose up --build` is enough.
#
# IMPORTANT: every name here must match a field on `Settings` in
# backend/app/config.py, which is case-sensitive and reads the environment
# directly. The previous version of this file used DATABASE_URL, REDIS_URL,
# JWT_SECRET and MINIO_ROOT_USER as application settings — none of which the
# application reads. Setting them looked like configuration and did nothing.

# --- Postgres -------------------------------------------------------------
# The app composes its DATABASE_URL from these; there is no DATABASE_URL
# setting. These must also match the credentials the db service is created
# with, which is why compose feeds both from the same variables.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=vaf
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vaf

# --- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO (S3-compatible) ------------------------------------------------
# MINIO_ROOT_USER/PASSWORD configure the *server*; MINIO_ACCESS_KEY/SECRET_KEY
# are what the *application* authenticates with. They must agree.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vaf-assets

# --- Celery ---------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth -----------------------------------------------------------------
# JWT_SECRET_KEY, not JWT_SECRET. The app warns at startup if this is left at
# its insecure default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=YOUR_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# AUTH_REQUIRED gates the app-level authentication middleware. Leave it true
# outside of tests. See docs/auth.md.
AUTH_REQUIRED=true

# --- AI -------------------------------------------------------------------
# Optional. Left empty, the copilot runs in its documented mock mode and the
# API still starts.
ANTHROPIC_API_KEY=

# --- Misc -----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,http://localhost:3000
